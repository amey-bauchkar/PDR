  Redirect 301 /aoc /products/aoc
  Redirect 301 /easycheck-v2 /products/easycheck-v2
  Redirect 301 /bendiboot-patchcord /products/bendiboot-patchcord
  Redirect 301 /smart-sfp /products/smart-sfp

  # ─── Old WordPress product-name slugs (Google-indexed) ───
  # These are the full product names slugified (e.g. "Fiber Optic Cleaner Pen MPO" → /fiber-optic-cleaner-pen-mpo)
  Redirect 301 /active-optical-cable-aoc /products/aoc
  Redirect 301 /variable-fiber-attenuator /products/attenuator
  Redirect 301 /fiber-optic-cleaner-pen /products/cleaner-pen
  Redirect 301 /fiber-optic-cleaner-pen-mpo /products/mpo-cleaner
  Redirect 301 /cwdm-mux-demux-module /products/cwdm
  Redirect 301 /cwdm-mux-demux /products/cwdm
  Redirect 301 /dwdm-mux-demux-module /products/dwdm
  Redirect 301 /dwdm-mux-demux /products/dwdm
  Redirect 301 /direct-attached-cable-dac /products/dac
  Redirect 301 /cat-6-patch-panel /products/cat6-panel
  Redirect 301 /cat-6-patch-cord /products/cat6-patch-cord
  Redirect 301 /fiber-distribution-box-fdb /products/fdb
  Redirect 301 /fiber-distribution-box /products/fdb
  Redirect 301 /g652d-fiber-spool-fiber-drum /products/fiber-spool
  Redirect 301 /fiber-spool-fiber-drum /products/fiber-spool
  Redirect 301 /fiber-optic-connector-field-installable /products/field-connector
  Redirect 301 /fiber-optic-patch-cords-pigtails /products/fo-patchcords
  Redirect 301 /fusion-splicer-pdr618h /products/fusion-splicer
