  Redirect 301 /cleaner-pen /products/cleaner-pen
  Redirect 301 /cwdm /products/cwdm
  Redirect 301 /dac /products/dac
  Redirect 301 /dwdm /products/dwdm
  Redirect 301 /easyget-wifi /products/wifi-wireless-fiber-endface-microscope
  Redirect 301 /products/easyget-wifi /products/wifi-wireless-fiber-endface-microscope
  Redirect 301 /fanout-patch-cords /products/fanout-patch-cords
  Redirect 301 /fdb /products/fdb
  Redirect 301 /fiber-spool /products/fiber-spool
  Redirect 301 /field-connector /products/field-connector
  Redirect 301 /fo-patchcords /products/fo-patchcords
  Redirect 301 /fusion-splicer /products/fusion-splicer
  Redirect 301 /heat-shrink-closure /products/heat-shrink-closure
  Redirect 301 /horizontal-closure /products/horizontal-closure
  Redirect 301 /htb /products/htb
  Redirect 301 /hybrid-adapter /products/hybrid-adapter
  Redirect 301 /lc-uniboot /products/lc-uniboot
