  Redirect 301 /smpte-cable-assembly /products/smpte-assembly
  Redirect 301 /vfl-visual-fault-locator /products/vfl
  Redirect 301 /optical-fiber-wall-mount-enclosure /products/wall-mount
  Redirect 301 /home-termination-box-htb /products/htb
  Redirect 301 /home-termination-box /products/htb
  Redirect 301 /easyget-wifi-wireless-fiber-endface-microscope /products/wifi-wireless-fiber-endface-microscope
  Redirect 301 /copper-sfp /products/sfp-copper
  Redirect 301 /sfp-10g-dual-fiber /products/sfp-10g-dual
  Redirect 301 /1g-sfp-bidi /products/sfp-1g-bidi
  Redirect 301 /1g-sfp-dual-fiber /products/sfp-1g-dual
  Redirect 301 /25g-25g-bidi /products/sfp-25g-bidi
  Redirect 301 /100g-100g-bidi /products/sfp-100g-bidi
  Redirect 301 /bypass-switch /products/bypass-switch
  Redirect 301 /ground-unit /products/drone
  Redirect 301 /sky-unit /products/fpv-optical-terminal
  Redirect 301 /uav-fiber-optic-spool /products/uav-fiber-optic-spool
  Redirect 301 /fiber-optic-adapter /products/fiber-optic-adapter

  # ─── Old .html URL redirects ───
  Redirect 301 /attenuator.html /products/attenuator
  Redirect 301 /bare-fiber-adapter.html /products/bare-fiber-adapter
  Redirect 301 /cassette-cleaner.html /products/cassette-cleaner
  Redirect 301 /cat6-panel.html /products/cat6-panel
  Redirect 301 /cat6-patch-cord.html /products/cat6-patch-cord
  Redirect 301 /cleaner-pen.html /products/cleaner-pen
  Redirect 301 /cpri-patchcord.html /products/cpri-patchcord
  Redirect 301 /cwdm.html /products/cwdm
  Redirect 301 /dac.html /products/dac
  Redirect 301 /dwdm.html /products/dwdm
  Redirect 301 /easyget-wifi.html /products/wifi-wireless-fiber-endface-microscope
  Redirect 301 /fanout-patch-cords.html /products/fanout-patch-cords
  Redirect 301 /fdb.html /products/fdb
  Redirect 301 /fiber-spool.html /products/fiber-spool
  Redirect 301 /field-connector.html /products/field-connector
  Redirect 301 /fo-patchcords.html /products/fo-patchcords
  Redirect 301 /fusion-splicer.html /products/fusion-splicer
  Redirect 301 /heat-shrink-closure.html /products/heat-shrink-closure
  Redirect 301 /horizontal-closure.html /products/horizontal-closure
  Redirect 301 /htb.html /products/htb
  Redirect 301 /hybrid-adapter.html /products/hybrid-adapter
  Redirect 301 /mode-conditioning.html /products/mode-conditioning
  Redirect 301 /mpo-assembly.html /products/mpo-assembly
  Redirect 301 /mpo-cleaner.html /products/mpo-cleaner
