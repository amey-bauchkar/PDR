  Redirect 301 /odf /products/odf
  Redirect 301 /olps /products/olps
  Redirect 301 /plc-splitter /products/plc-splitter
  Redirect 301 /pocket-otdr /products/pocket-otdr
  Redirect 301 /pof-patchcord /products/pof-patchcord
  Redirect 301 /pon-power-meter /products/pon-power-meter
  Redirect 301 /rack-mount-fms /products/rack-mount-fms
  Redirect 301 /regular-opm /products/regular-opm
  Redirect 301 /sfp-100g-bidi /products/sfp-100g-bidi
  Redirect 301 /sfp-10g-bidi /products/sfp-10g-bidi
  Redirect 301 /sfp-10g-dual /products/sfp-10g-dual
  Redirect 301 /sfp-1g-bidi /products/sfp-1g-bidi
  Redirect 301 /sfp-1g-dual /products/sfp-1g-dual
  Redirect 301 /sfp-25g-bidi /products/sfp-25g-bidi
  Redirect 301 /sfp-400g /products/sfp-400g
  Redirect 301 /sfp-40g /products/sfp-40g
  Redirect 301 /sfp-copper /products/sfp-copper
