  Redirect 301 /olps.html /products/olps
  Redirect 301 /plc-splitter.html /products/plc-splitter
  Redirect 301 /pocket-otdr.html /products/pocket-otdr
  Redirect 301 /pof-patchcord.html /products/pof-patchcord
  Redirect 301 /pon-power-meter.html /products/pon-power-meter
  Redirect 301 /rack-mount-fms.html /products/rack-mount-fms
  Redirect 301 /rapid-push.html /products/rapid-push
  Redirect 301 /regular-opm.html /products/regular-opm
  Redirect 301 /sfp-100g-bidi.html /products/sfp-100g-bidi
  Redirect 301 /sfp-10g-bidi.html /products/sfp-10g-bidi
  Redirect 301 /sfp-10g-dual.html /products/sfp-10g-dual
  Redirect 301 /sfp-1g-bidi.html /products/sfp-1g-bidi
  Redirect 301 /sfp-1g-dual.html /products/sfp-1g-dual
  Redirect 301 /sfp-25g-bidi.html /products/sfp-25g-bidi
  Redirect 301 /sfp-400g.html /products/sfp-400g
  Redirect 301 /sfp-40g.html /products/sfp-40g
  Redirect 301 /sfp-copper.html /products/sfp-copper
  Redirect 301 /smart-sfp.html /products/smart-sfp
  Redirect 301 /smpte-assembly.html /products/smpte-assembly
  Redirect 301 /vfl.html /products/vfl
  Redirect 301 /wall-mount.html /products/wall-mount
  Redirect 301 /bypass-switch.html /products/bypass-switch
  Redirect 301 /nano-otdr /products/pocket-otdr
  Redirect 301 /products/nano-otdr /products/pocket-otdr
  Redirect 301 /products/nano-otdr.html /products/pocket-otdr

  # ─── Custom 404 Page ───
  ErrorDocument 404 /404.html

  # ─── Static files and assets: serve directly without rewriting ───
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ─── If a directory with index.html exists, serve it directly ───
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # ─── If prerendered static route index.html exists, serve it (e.g. /products/sfp-400g -> products/sfp-400g/index.html) ───
  RewriteCond %{REQUEST_URI} !^/(api|cdn) [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # ─── Real-Time Dynamic Sitemap Rewrite (Direct DB Sync) ───
  RewriteCond %{REQUEST_URI} ^/sitemap\.xml$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/sitemap.php -f
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # ─── Admin SPA route fallback (for authenticated client dashboard) ───
  RewriteCond %{REQUEST_URI} ^/(admin|admin-new|dashboard-admin) [NC]
  RewriteRule ^ index.html [L]

  # ─── Non-existent routes: return real HTTP 404 status (eliminates Soft 404 errors) ───
  RewriteCond %{REQUEST_URI} !^/(api|cdn) [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>
