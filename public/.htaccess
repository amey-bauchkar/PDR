<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve actual asset files (JS, CSS, images, PDFs, etc.) directly
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|webp|svg|ico|pdf|woff|woff2|ttf|eot|json|xml|txt)$ [NC]
  RewriteRule ^ - [L]

  # For ALL other requests (HTML pages, SPA routes), serve root index.html
  # This ensures the latest JS bundle is always loaded, even if old
  # prerendered HTML files exist from previous deploys
  RewriteRule ^ /index.html [L]
</IfModule>
