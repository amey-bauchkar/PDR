<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ─── Canonical: www → non-www redirect ───
  RewriteCond %{HTTP_HOST} ^www\.pdrworld\.com$ [NC]
  RewriteRule ^(.*)$ https://pdrworld.com/$1 [R=301,L]

  # 301 Permanent Redirects for legacy WordPress URLs
  Redirect 301 /about-us /about
  Redirect 301 /contact-us /contact
  Redirect 301 /products/cable-management-devices /products/cable-management
  Redirect 301 /products/test-measuring-equipment /products/test-measuring
  
  # Individual Product Redirects
  Redirect 301 /armoured-patchcord /products/armoured-patchcord
  Redirect 301 /cpri-patchcord /products/cpri-patchcord
  Redirect 301 /fan-out-patch-cord /products/fanout-patch-cords
  Redirect 301 /3u-cassette-splitter-rack /products/rack-mount-fms
  Redirect 301 /1-6mm-patchcord /products/fo-patchcords
  Redirect 301 /fiber-distribution-box /products/fdb
  Redirect 301 /rapid-push-connector /products/rapid-push

  # ─── Missed Legacy WordPress Redirects ───
  Redirect 301 /disclaimer /about
  RewriteRule ^wp-content/(.*)$ /products [R=301,L]

  # ─── Legacy WordPress Category/Page Redirects ───
  Redirect 301 /fiber-optic-patch-cords-and-pigtails /products/passive-components
  Redirect 301 /fiber-optic-patch-cord /products/fo-patchcords
  Redirect 301 /fiber-optic-patch-cords /products/fo-patchcords
  Redirect 301 /patch-cord /products/fo-patchcords
  Redirect 301 /patch-cords /products/fo-patchcords
  Redirect 301 /patchcord /products/fo-patchcords
  Redirect 301 /patchcords /products/fo-patchcords
  Redirect 301 /pigtails /products/passive-components
  Redirect 301 /active-components /products/active-components
  Redirect 301 /passive-components /products/passive-components
  Redirect 301 /cable-management /products/cable-management
  Redirect 301 /cable-management-devices /products/cable-management
  Redirect 301 /test-measuring-equipment /products/test-measuring
  Redirect 301 /test-and-measurement /products/test-measuring
  Redirect 301 /sfp-transceivers /products/active-components
  Redirect 301 /sfp-transceiver /products/active-components
  Redirect 301 /optical-fiber /products/passive-components
  Redirect 301 /fiber-optic /products
  Redirect 301 /product-category /products
  Redirect 301 /product /products
  Redirect 301 /catalogue /resources

  # ─── Bare product slug redirects (slug without /products/ prefix) ───
  Redirect 301 /attenuator /products/attenuator
  Redirect 301 /bare-fiber-adapter /products/bare-fiber-adapter
  Redirect 301 /cassette-cleaner /products/cassette-cleaner
  Redirect 301 /cat6-panel /products/cat6-panel
