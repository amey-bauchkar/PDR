{
  "buildCommand": "npm run build:full",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/admin(.*)", "destination": "/index.html" },
    { "source": "/dashboard-admin(.*)", "destination": "/index.html" },
    { "source": "/admin-new(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/pocket-otdr", "destination": "/products/nano-otdr", "permanent": true },
    { "source": "/products/pocket-otdr", "destination": "/products/nano-otdr", "permanent": true },
    { "source": "/drone", "destination": "/products/ground-unit", "permanent": true },
    { "source": "/products/drone", "destination": "/products/ground-unit", "permanent": true },
    { "source": "/fpv-optical-terminal", "destination": "/products/sky-unit", "permanent": true },
    { "source": "/products/fpv-optical-terminal", "destination": "/products/sky-unit", "permanent": true },
    { "source": "/rapid-push", "destination": "/products/fttx-smart-bullet-drop-cable", "permanent": true },
    { "source": "/products/rapid-push", "destination": "/products/fttx-smart-bullet-drop-cable", "permanent": true },
    { "source": "/easyget-wifi", "destination": "/products/test-measuring", "permanent": true },
    { "source": "/products/easyget-wifi", "destination": "/products/test-measuring", "permanent": true },
    { "source": "/wifi-wireless-fiber-endface-microscope", "destination": "/products/test-measuring", "permanent": true },
    { "source": "/products/wifi-wireless-fiber-endface-microscope", "destination": "/products/test-measuring", "permanent": true }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/products(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/dashboard-admin(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin-new(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
